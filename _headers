/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/*.js
  Cache-Control: no-cache
/*.css
  Cache-Control: no-cache
/dados/*
  Cache-Control: no-cache
/precos.json
  Cache-Control: no-cache
